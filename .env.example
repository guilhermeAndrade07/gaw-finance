# === Development ===
# Copy this file to .env and adjust as needed.

# Django
DJANGO_ENV=dev
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database (dev uses SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Celery (optional in dev - only needed if testing async tasks)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0

# === WhatsApp / Evolution API ===
# URL da Evolution API acessivel pelo backend (dentro do compose: http://evolution-api:8080)
EVOLUTION_API_URL=http://localhost:8080
# API key configurada na Evolution (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=gaw-evolution-key
EVOLUTION_INSTANCE_NAME=gaw-finance
# Secret enviado pela Evolution no header do webhook e validado pelo Django
WHATSAPP_WEBHOOK_SECRET=troque-este-secret-webhook

# === LLM (interpretacao das mensagens) ===
# Provider: opencode | openai
LLM_PROVIDER=opencode
# OpenCode Go (assinatura): base URL https://opencode.ai/zen/go/v1
# OpenCode Zen (pay-per-use): base URL https://opencode.ai/zen/v1
# Exige o header x-opencode-session (enviado automaticamente pelo backend).
# Modelos testados: glm-5.3-flash, kimi-k2.6 (deepseek exige regiao Global
# nas configuracoes de privacidade do workspace).
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=glm-5.3-flash

# === Production (set in .env.prod on VPS) ===
# DJANGO_ENV=prd
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,.yourdomain.com,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
# POSTGRES_DB=gaw_db
# POSTGRES_USER=gaw_db_user
# DOMAIN=yourdomain.com
# ACME_EMAIL=your-email@example.com
# GHCR_USER=guilhermeAndrade07
# GHCR_TOKEN=your-github-pat-with-read-packages-scope
#
# Docker Secrets (created on VPS, NOT in .env):
#   gaw_secret_key       -> Django SECRET_KEY
#   gaw_db_password      -> PostgreSQL password
#   gaw_rabbitmq_password -> RabbitMQ password for the gaw_app user
#   CLOUDFLARE_DNS_API_TOKEN -> Cloudflare API token for DNS-01 challenge
